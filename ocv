#!/usr/bin/env bash
# Re-exec in bash if run with sh
if [[ -z "${BASH_VERSION:-}" ]]; then exec /usr/bin/env bash "$0" "$@"; fi

set -euo pipefail

MIRROR_ROOT="https://mirror.openshift.com/pub/openshift-v4"
MIRROR_BASE="${MIRROR_ROOT}/clients/ocp"
# Engineering/feature candidates are published here instead of under ocp/
DEV_PREVIEW_BASE="${MIRROR_ROOT}/clients/ocp-dev-preview"
DRY_RUN=false
FORCE=false
IGNORE_SHA=false

# Configuration and caching
CONFIG_FILE="${HOME}/.ocv.conf"
CACHE_DIR="${HOME}/.cache/ocv"
CACHE_TIMEOUT=3600  # 1 hour
DEFAULT_SERIES=""

# X.Y.Z (GA) or X.Y.Z-{ec,fc,rc}.N (pre-release). Nightlies/hotfixes are ignored.
VERSION_RE='[0-9]+\.[0-9]+\.[0-9]+(-(ec|fc|rc)\.[0-9]+)?'
GA_RE='[0-9]+\.[0-9]+\.[0-9]+'
PRERELEASE_RE='[0-9]+\.[0-9]+\.[0-9]+-(ec|fc|rc)\.[0-9]+'
TEMP_DIR=""

# Cleanup and error handling
cleanup_on_exit() {
  if [[ -n "${TEMP_DIR:-}" && -d "$TEMP_DIR" ]]; then
    rm -rf "$TEMP_DIR" 2>/dev/null || true
  fi
}
# EXIT trap handles cleanup; INT/TERM just exit with the conventional
# signal status, which fires the EXIT trap exactly once.
trap cleanup_on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Use a proper temp directory
TEMP_DIR="$(mktemp -d -t ocv-XXXXXX)"

load_config() {
  # Parse key=value instead of sourcing: safer (no arbitrary code execution)
  # and a malformed line can't kill the script under `set -e`.
  if [[ -f "$CONFIG_FILE" ]]; then
    local line
    line="$(grep -E '^DEFAULT_SERIES="?[0-9]+\.[0-9]+"?$' "$CONFIG_FILE" | tail -n1 || true)"
    if [[ -n "$line" ]]; then
      DEFAULT_SERIES="${line#DEFAULT_SERIES=}"
      DEFAULT_SERIES="${DEFAULT_SERIES//\"/}"
    fi
  fi
}

save_config() {
  mkdir -p "$(dirname "$CONFIG_FILE")"
  cat > "$CONFIG_FILE" <<EOF
# OCV Configuration
DEFAULT_SERIES="$DEFAULT_SERIES"
EOF
}

usage() {
  cat <<EOF
OpenShift CLI Version Manager

Usage:
  $(basename "$0") list                     # list remote GA versions (* = active, + = installed)
  $(basename "$0") list beta               # list unreleased pre-releases (ec/fc/rc)
  $(basename "$0") list all                # list GA and all pre-release versions
  $(basename "$0") list installed          # list versions installed locally
  $(basename "$0") list latest <series>    # show latest GA patch of series, without installing
  $(basename "$0") list <series>           # list remote versions of a series (e.g., list 4.18)
  $(basename "$0") <version>               # install specific version (e.g., 4.18.24, 4.23.0-ec.1)
  $(basename "$0") latest <series>         # install latest patch of series (e.g., latest 4.18)
  $(basename "$0") latest                  # install latest of remembered series
  $(basename "$0") use <version>           # switch to already installed version
  $(basename "$0") current                 # show current symlinks and active version
  $(basename "$0") check                   # check for updates to current version
  $(basename "$0") delete <version>        # remove version (relinks if needed)

Examples:
  $(basename "$0") list installed          # Show what's installed locally
  $(basename "$0") list latest 4.18        # Print latest 4.18.x (no install)
  $(basename "$0") list 4.18               # Show all remote 4.18.x versions
  $(basename "$0") list beta               # Show pre-releases of upcoming versions
  $(basename "$0") 4.18.24                 # Install specific version
  $(basename "$0") 5.0.0-rc.7              # Install a pre-release (never picked by 'latest')
  $(basename "$0") latest 4.18             # Install latest 4.18.x (remembers series)
  $(basename "$0") latest                   # Install latest of remembered series
  $(basename "$0") use 4.16.30             # Switch to already installed version
  $(basename "$0") check                    # Check if newer version available
  $(basename "$0") delete 4.16.30          # Remove old version

Options:
  --dry-run      Show what would happen without making changes
  --force        Force reinstall of an already installed version
  --ignore-sha   Skip SHA256 verification

Configuration:
  Config file: ~/.ocv.conf
  Cache dir: ~/.cache/ocv/
EOF
}

# Input validation
validate_version() {
  local version="$1"
  if [[ ! "$version" =~ ^${VERSION_RE}$ ]]; then
    echo "Error: Invalid version format '$version'. Expected X.Y.Z or X.Y.Z-{ec,fc,rc}.N (e.g., 4.18.24, 5.0.0-rc.7)" >&2
    return 1
  fi
}

is_prerelease() {
  [[ "$1" =~ ^${PRERELEASE_RE}$ ]]
}

# Version comparison utilities
# Portable version sort (works on both BSD/macOS and GNU sort; `sort -V` is
# not available on stock macOS, and GNU `sort -V` puts 5.0.0 before
# 5.0.0-rc.0). Each line gets a numeric key "X Y Z stage N", where
# stage is ec=0 < fc=1 < rc=2 < GA=3, then the key is stripped.
version_sort() {
  awk '{
    v = $0; stage = 3; n = 0
    if (match(v, /-(ec|fc|rc)\.[0-9]+$/)) {
      split(substr(v, RSTART + 1), p, ".")
      stage = (p[1] == "ec") ? 0 : (p[1] == "fc") ? 1 : 2
      n = p[2]
      v = substr(v, 1, RSTART - 1)
    }
    split(v, a, ".")
    print a[1]+0, a[2]+0, a[3]+0, stage, n+0, $0
  }' | sort -k1,1n -k2,2n -k3,3n -k4,4n -k5,5n | cut -d' ' -f6
}

version_min() {
  local v1="$1" v2="$2"
  printf '%s\n%s\n' "$v1" "$v2" | version_sort | head -n1
}

is_version_newer() {
  local current="$1" candidate="$2"
  [[ "$candidate" != "$(version_min "$current" "$candidate")" ]]
}

# Download with progress and resume capability.
# Downloads land in $CACHE_DIR/downloads (not the per-run temp dir) so an
# interrupted download is actually resumable on the next invocation.
download_with_progress() {
  local url="$1" output="$2"
  echo "Downloading $(basename "$output")..."

  if command -v curl >/dev/null 2>&1; then
    curl -fL --progress-bar -C - -o "$output" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -c -O "$output" "$url" --progress=bar:force 2>&1
  else
    echo "Error: Neither curl nor wget found" >&2
    return 1
  fi
}

# ---------- path helpers ----------
bin_root() { echo "$HOME/bin"; }
ocp_root() { echo "$(bin_root)/ocp"; }
version_dir() { echo "$(ocp_root)/$1"; }

# ---------- active version helper ----------
active_version() {
  local br; br="$(bin_root)"
  local t
  if [[ -L "${br}/oc" ]]; then
    t="$(readlink "${br}/oc")"
    if [[ "$t" =~ /ocp/(${VERSION_RE})/oc$ ]]; then
      echo "${BASH_REMATCH[1]}"; return 0
    fi
  fi
  if [[ -L "${br}/openshift-install" ]]; then
    t="$(readlink "${br}/openshift-install")"
    if [[ "$t" =~ /ocp/(${VERSION_RE})/openshift-install$ ]]; then
      echo "${BASH_REMATCH[1]}"; return 0
    fi
  fi
  return 1
}

# ---------- listings with caching ----------
# Usage: fetch_cached <cache file name> <mode> <producer function>
#   Prints the cached output of <producer>, re-running it when the cache is
#   older than CACHE_TIMEOUT or mode is "refresh" (used by `check`).
fetch_cached() {
  local name="$1" mode="$2" producer="$3"
  local cache_file="${CACHE_DIR}/${name}"
  local cache_age=999999

  mkdir -p "$CACHE_DIR"

  if [[ -f "$cache_file" ]]; then
    cache_age=$(($(date +%s) - $(stat -f%m "$cache_file" 2>/dev/null || stat -c%Y "$cache_file" 2>/dev/null || echo 0)))
  fi

  if [[ "$mode" == "refresh" || $cache_age -gt $CACHE_TIMEOUT ]]; then
    echo "Fetching latest versions..." >&2
    # Write to a temp file and swap in only on success, so a network
    # failure never truncates/destroys the existing cache.
    local tmp="${TEMP_DIR}/${name}"
    if "$producer" > "$tmp" && [[ -s "$tmp" ]]; then
      mv -f "$tmp" "$cache_file"
    elif [[ -s "$cache_file" ]]; then
      echo "Using cached versions (network unavailable)" >&2
    else
      echo "No cached versions available" >&2
      return 1
    fi
  fi

  cat "$cache_file" 2>/dev/null || return 1
}

# Producers: scrape the mirror's directory listings.
# -f makes curl fail on HTTP errors (plain -s would cache an error page).
_fetch_ga_versions() {
  curl -fsS "${MIRROR_BASE}/" \
    | grep -Eo "href=\"${GA_RE}/" \
    | sed 's/href="//;s#/##' \
    | version_sort \
    | uniq
}

# RCs live under ocp/, ECs and FCs mostly under ocp-dev-preview/.
_fetch_prerelease_versions() {
  { curl -fsS "${MIRROR_BASE}/" && curl -fsS "${DEV_PREVIEW_BASE}/"; } \
    | grep -Eo "href=\"${PRERELEASE_RE}/" \
    | sed 's/href="//;s#/##' \
    | version_sort \
    | uniq
}

# Usage: list_remote_versions [refresh]   -> GA versions only
list_remote_versions() {
  fetch_cached versions.txt "${1:-}" _fetch_ga_versions
}

# Usage: list_prerelease_versions [refresh]   -> every ec/fc/rc on the mirror
list_prerelease_versions() {
  fetch_cached prereleases.txt "${1:-}" _fetch_prerelease_versions
}

# Usage: list_beta_versions [refresh]
#   Pre-releases of series (X.Y) that have no GA release yet, i.e. the betas
#   that are still relevant. Matched by series rather than by X.Y.Z because
#   some series never shipped an X.Y.0 GA (4.18 started at 4.18.1).
list_beta_versions() {
  local ga; ga="$(list_remote_versions "${1:-}")" || return 1
  list_prerelease_versions "${1:-}" \
    | awk -F. 'NR == FNR { ga[$1 "." $2] = 1; next } !(($1 "." $2) in ga)' \
        <(printf '%s\n' "$ga") -
}

# Usage: list_all_versions   -> GA and every pre-release, sorted
list_all_versions() {
  { list_remote_versions && list_prerelease_versions; } | version_sort
}

# Reads versions on stdin, prints them with markers (* = active, + = installed)
print_marked_versions() {
  local installed; installed="$(raw_installed_versions)"
  local av; av="$(active_version 2>/dev/null || true)"
  local v
  while IFS= read -r v; do
    if [[ -n "$av" && "$v" == "$av" ]]; then
      echo "* $v"
    elif printf '%s\n' "$installed" | grep -qxF "$v"; then
      echo "+ $v"
    else
      echo "  $v"
    fi
  done
}

# Pretty, marked list (for user)
list_installed_versions() {
  local root; root="$(ocp_root)"
  local active; active="$(active_version 2>/dev/null || true)"
  if [[ -d "$root" ]]; then
    find "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
      | awk -F/ '{print $NF}' \
      | grep -E "^${VERSION_RE}$" \
      | version_sort \
      | while read -r v; do
          if [[ -n "$active" && "$v" == "$active" ]]; then
            echo "* $v"
          else
            echo "  $v"
          fi
        done
  else
    echo "(none installed)"
  fi
}

# Raw, unformatted list (for internal logic)
raw_installed_versions() {
  local root; root="$(ocp_root)"
  if [[ -d "$root" ]]; then
    find "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null \
      | awk -F/ '{print $NF}' \
      | grep -E "^${VERSION_RE}$" \
      | version_sort
  fi
}

# Highest installed GA version; falls back to the highest pre-release only
# when no GA version is installed.
latest_installed_version() {
  local all; all="$(raw_installed_versions)"
  local ga; ga="$(printf '%s\n' "$all" | grep -E "^${GA_RE}$" | tail -n1 || true)"
  if [[ -n "$ga" ]]; then
    echo "$ga"
  else
    printf '%s\n' "$all" | tail -n1
  fi
}

# Update checking functionality
check_for_updates() {
  local current; current="$(active_version 2>/dev/null || echo "none")"
  if [[ "$current" == "none" ]]; then
    echo "No version currently active"
    return 0
  fi

  local series; series="$(echo "$current" | cut -d. -f1,2)"  # X.Y from X.Y.Z[-rc.N]
  # Force a cache refresh: checking for updates against a stale cache
  # defeats the purpose of `check`.
  local latest; latest="$(resolve_latest_of_series "$series" refresh 2>/dev/null || echo "")"
  local hint="ocv latest $series"

  # On a pre-release of a series with no GA yet, the update is a newer beta.
  if [[ -z "$latest" ]] && is_prerelease "$current"; then
    latest="$(list_beta_versions refresh 2>/dev/null | grep -E "^${series//./\\.}\." | tail -n1 || true)"
    hint="ocv $latest"
  fi

  if [[ -n "$latest" && "$latest" != "$current" ]] && is_version_newer "$current" "$latest"; then
    echo "📦 Update available: $current → $latest"
    echo "Run: $hint"
  else
    echo "✅ You're on the latest version of series $series: $current"
  fi
}

# ---------- platform detection & artifact selection ----------
OS_NAME="" ARCH_NAME="" EXT=".tar.gz"

detect_platform() {
  OS_NAME="$(uname -s)"
  ARCH_NAME="$(uname -m)"
  case "$OS_NAME" in
    Darwin|Linux) : ;;
    *) echo "Unsupported OS: $OS_NAME" >&2; exit 2 ;;
  esac
  # EXT already set to .tar.gz (Windows ZIPs are not relevant here)
}

# Mirror "clients" directory holding the artifacts for this platform.
# The default mirror's generic "linux" artifacts are amd64; ppc64le and s390x
# builds (including openshift-install) live under a per-arch mirror, where
# the generic name is the native binary.
platform_clients_root() {
  case "$OS_NAME/$ARCH_NAME" in
    Linux/ppc64le|Linux/s390x)
      echo "${MIRROR_ROOT}/${ARCH_NAME}/clients" ;;
    *)
      echo "${MIRROR_ROOT}/clients" ;;
  esac
}

# Echo the mirror URL of a version's directory, or fail if it isn't there.
# GA versions live under ocp/; pre-releases under ocp/ (RCs) or
# ocp-dev-preview/ (ECs/FCs), so those are probed in that order.
version_base_url() {
  local version="$1"
  local root; root="$(platform_clients_root)"
  local dirs=(ocp)
  is_prerelease "$version" && dirs+=(ocp-dev-preview)
  local d
  for d in "${dirs[@]}"; do
    if curl -fsI "${root}/${d}/${version}/sha256sum.txt" >/dev/null 2>&1; then
      echo "${root}/${d}/${version}"
      return 0
    fi
  done
  echo "Error: version ${version} not found on the mirror (looked in: ${dirs[*]} under ${root})" >&2
  return 1
}

# List candidate artifact names (in order), given kind=install|client and a version
artifact_candidates() {
  local kind="$1" version="$2"
  case "$OS_NAME" in
    Darwin)
      case "$ARCH_NAME" in
        arm64)
          if [[ "$kind" == "install" ]]; then
            printf "openshift-install-mac-arm64-%s%s\n" "$version" "$EXT"
            printf "openshift-install-mac-%s%s\n"        "$version" "$EXT"
          else
            printf "openshift-client-mac-arm64-%s%s\n" "$version" "$EXT"
            printf "openshift-client-mac-%s%s\n"        "$version" "$EXT"
          fi
          ;;
        x86_64)
          if [[ "$kind" == "install" ]]; then
            printf "openshift-install-mac-%s%s\n" "$version" "$EXT"
          else
            printf "openshift-client-mac-%s%s\n" "$version" "$EXT"
          fi
          ;;
        *)
          echo "Unsupported macOS arch: $ARCH_NAME" >&2; exit 2 ;;
      esac
      ;;
    Linux)
      case "$ARCH_NAME" in
        x86_64|amd64)
          if [[ "$kind" == "install" ]]; then
            printf "openshift-install-linux-%s%s\n" "$version" "$EXT"
            printf "openshift-install-linux-x86_64-%s%s\n" "$version" "$EXT"
          else
            printf "openshift-client-linux-%s%s\n" "$version" "$EXT"
            printf "openshift-client-linux-x86_64-%s%s\n" "$version" "$EXT"
          fi
          ;;
        aarch64|arm64)
          # No generic fallback: the generic linux artifact is amd64.
          if [[ "$kind" == "install" ]]; then
            printf "openshift-install-linux-arm64-%s%s\n" "$version" "$EXT"
          else
            printf "openshift-client-linux-arm64-%s%s\n" "$version" "$EXT"
          fi
          ;;
        ppc64le|s390x)
          # Served from the per-arch mirror (see platform_mirror_base),
          # where the generic name is the native binary.
          if [[ "$kind" == "install" ]]; then
            printf "openshift-install-linux-%s%s\n" "$version" "$EXT"
          else
            printf "openshift-client-linux-%s%s\n"                "$version" "$EXT"
            printf "openshift-client-linux-%s-rhel9-%s%s\n" "$ARCH_NAME" "$version" "$EXT"
            printf "openshift-client-linux-%s-rhel8-%s%s\n" "$ARCH_NAME" "$version" "$EXT"
          fi
          ;;
        *)
          echo "Unsupported Linux arch: $ARCH_NAME" >&2; exit 2 ;;
      esac
      ;;
  esac
}

# Pick the first candidate that exists on the mirror; echo filename or fail
pick_artifact() {
  local kind="$1" version="$2" base_url="$3"
  local cand
  while IFS= read -r cand; do
    if curl -fsI "${base_url}/${cand}" >/dev/null; then
      echo "$cand"
      return 0
    fi
  done < <(artifact_candidates "$kind" "$version")
  echo "Error: no ${kind} artifact found for OS=${OS_NAME} ARCH=${ARCH_NAME} version=${version}" >&2
  echo "Tried:" >&2
  artifact_candidates "$kind" "$version" | sed 's/^/  - /' >&2
  return 1
}

verify_sha256() {
  local version="$1" file_path="$2" base_url="$3"
  local file_name; file_name="$(basename "$file_path")"
  local sums_url="${base_url}/sha256sum.txt"

  if [[ "${IGNORE_SHA:-false}" == "true" ]]; then
    echo "⚠️  SHA256 verification skipped (--ignore-sha enabled) for ${file_name}"
    return 0
  fi

  if $DRY_RUN; then
    echo "DRY-RUN: verify sha256 of ${file_name} using ${sums_url}"
    return 0
  fi

  # Fail closed: these are binaries going into PATH. If we can't verify,
  # we abort — only --ignore-sha may bypass verification.
  local sums_file="${TEMP_DIR}/sha256sum-${version}.txt"
  if ! curl -fsS -o "$sums_file" "$sums_url"; then
    echo "Error: could not fetch ${sums_url} (network or file missing)" >&2
    echo "Refusing to install unverified binaries. Use --ignore-sha to bypass." >&2
    exit 3
  fi

  local expected
  expected="$(awk -v fn="$file_name" '$2==fn || $2==("*"fn){print $1}' "$sums_file" | head -n1)"
  if [[ -z "${expected:-}" ]]; then
    echo "Error: no entry for $file_name in sha256sum.txt for ${version}" >&2
    echo "Refusing to install unverified binaries. Use --ignore-sha to bypass." >&2
    exit 3
  fi

  local actual
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$file_path" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "$file_path" | awk '{print $1}')"
  fi
  [[ "$actual" == "$expected" ]] || {
    # Drop the bad archive from the download cache; otherwise the next run
    # "resumes" a file that is already complete and fails here forever.
    rm -f "$file_path"
    echo "Invalid SHA256 for $file_name (removed from cache, re-run to download again)" >&2
    echo "Expected: $expected" >&2
    echo "Actual:   $actual" >&2
    echo "Use --ignore-sha to skip verification if you're aware of known mismatches." >&2
    exit 3
  }
  echo "✅ SHA256 verified: ${file_name}"
}

extract_tar() {
  local archive="$1" dest="$2"
  if $DRY_RUN; then
    echo "DRY-RUN: tar -xzf \"$archive\" -C \"$dest\""
    return
  fi
  mkdir -p "$dest"
  tar -xzf "$archive" -C "$dest" || {
    # Same reasoning as a SHA mismatch: don't keep a corrupt cached archive.
    rm -f "$archive"
    echo "Error: failed to extract $(basename "$archive") (removed from cache, re-run to download again)" >&2
    exit 4
  }
}

# ---------- operations ----------
link_version() {
  local version="$1"
  local br; br="$(bin_root)"
  local vd; vd="$(version_dir "$version")"

  if $DRY_RUN; then
    echo "DRY-RUN: ln -sfn ${vd}/oc ${br}/oc"
    echo "DRY-RUN: ln -sfn ${vd}/openshift-install ${br}/openshift-install"
    return
  fi

  ln -sfn "${vd}/oc"                "${br}/oc"
  ln -sfn "${vd}/openshift-install" "${br}/openshift-install"
  echo "Symlinks updated -> ${version}"

  if ! echo ":$PATH:" | grep -q ":$HOME/bin:"; then
    echo "ℹ️  Add ~/bin to PATH (e.g., zsh):"
    echo '   echo '\''export PATH="$HOME/bin:$PATH"'\'' >> ~/.zshrc && exec zsh'
  fi
}

use_version() {
  local version="$1"
  validate_version "$version" || exit 1
  local vd; vd="$(version_dir "$version")"
  [[ -d "$vd" ]] || { echo "Version not installed: ${vd}"; exit 4; }
  link_version "$version"
}

current_version() {
  local br; br="$(bin_root)"
  local oc_target install_target version=""

  if [[ -L "${br}/oc" ]]; then
    oc_target="$(readlink "${br}/oc")"
    echo "oc -> $oc_target"
    [[ "$oc_target" =~ /ocp/(${VERSION_RE})/oc$ ]] && version="${BASH_REMATCH[1]}"
  else
    echo "oc symlink not found"
  fi

  if [[ -L "${br}/openshift-install" ]]; then
    install_target="$(readlink "${br}/openshift-install")"
    echo "openshift-install -> $install_target"
    if [[ -z "$version" && "$install_target" =~ /ocp/(${VERSION_RE})/openshift-install$ ]]; then
      version="${BASH_REMATCH[1]}"
    fi
  else
    echo "openshift-install symlink not found"
  fi

  if [[ -n "$version" ]]; then
    if [[ -n "${oc_target:-}" && -n "${install_target:-}" ]]; then
      # Escape dots so 4.18.24 can't accidentally match e.g. 4x18y24
      local escaped_version="${version//./\\.}"
      if [[ ! "$oc_target" =~ /ocp/${escaped_version}/oc$ || ! "$install_target" =~ /ocp/${escaped_version}/openshift-install$ ]]; then
        echo "⚠️  Warning: 'oc' and 'openshift-install' point to different versions."
      fi
    fi
    echo "active version: $version"
  else
    echo "active version: (undefined)"
  fi
}

delete_version() {
  local version="$1"
  validate_version "$version" || exit 1
  local br; br="$(bin_root)"
  local vd; vd="$(version_dir "$version")"

  [[ -d "$vd" ]] || { echo "Version not found: ${vd}"; exit 4; }

  # Consider "current" if either symlink points to this version
  local was_current=false
  [[ -L "${br}/oc" && "$(readlink "${br}/oc")" == "${vd}/oc" ]] && was_current=true
  [[ -L "${br}/openshift-install" && "$(readlink "${br}/openshift-install")" == "${vd}/openshift-install" ]] && was_current=true

  if $DRY_RUN; then
    echo "DRY-RUN: rm -rf ${vd}"
  else
    rm -rf "${vd}"
    echo "Removed version ${version}"
  fi

  # Determine highest remaining version after deletion
  local latest; latest="$(latest_installed_version || true)"

  # Are current symlinks valid?
  local oc_ok=false inst_ok=false
  [[ -L "${br}/oc"                && -e "$(readlink "${br}/oc")"                ]] && oc_ok=true
  [[ -L "${br}/openshift-install" && -e "$(readlink "${br}/openshift-install")" ]] && inst_ok=true
  local symlinks_broken=false
  $oc_ok && $inst_ok || symlinks_broken=true

  if [[ -n "${latest:-}" && -d "$(version_dir "$latest")" ]]; then
    # If deleted was active OR links are broken/missing, relink to latest
    if $was_current || $symlinks_broken; then
      echo "Relinking to ${latest}"
      link_version "$latest"
    fi
  else
    # No versions left — remove symlinks
    echo "No other versions installed, removing symlinks"
    if $DRY_RUN; then
      echo "DRY-RUN: rm -f \"${br}/oc\" \"${br}/openshift-install\""
    else
      rm -f "${br}/oc" "${br}/openshift-install"
    fi
  fi

  # Show current state after delete
  current_version
}

# Usage: resolve_latest_of_series <series> [refresh]
resolve_latest_of_series() {
  local series="$1" mode="${2:-}"   # e.g.: 4.18
  [[ "$series" =~ ^[0-9]+\.[0-9]+$ ]] || { echo "Invalid series: $series (use X.Y, e.g. 4.18)" >&2; return 1; }
  local escaped_series="${series//./\\.}"
  local result
  result="$(list_remote_versions "$mode" \
    | grep -E "^${escaped_series}\.[0-9]+$" \
    | version_sort \
    | tail -n1 || true)"
  if [[ -z "$result" ]]; then
    echo "No versions found for series ${series} on the mirror" >&2
    return 1
  fi
  echo "$result"
}

install_version() {
  local version="$1"
  validate_version "$version" || exit 1
  local vd; vd="$(version_dir "$version")"

  if [[ -d "$vd" && "$FORCE" != "true" ]]; then
    echo "Version $version already installed at $vd"
    echo "Use 'ocv use $version' to switch, or --force to reinstall"
    return 0
  fi
  # Note: with --force the existing install is only removed at the very
  # end, after download/verify/extract all succeed (atomic swap below).

  if $DRY_RUN; then
    if is_prerelease "$version"; then
      echo "DRY-RUN: would locate ${version} under ${MIRROR_BASE}/ or ${DEV_PREVIEW_BASE}/"
    fi
    echo "DRY-RUN: would probe & download .../${version}/{openshift-install-...,openshift-client-...}.tar.gz"
    echo "DRY-RUN: would extract into ${vd} and update symlinks in $(bin_root)"
    return
  fi

  detect_platform

  local base_url; base_url="$(version_base_url "$version")" || exit 4
  # choose filenames by probing the mirror
  local installer; installer="$(pick_artifact install "$version" "$base_url")" || exit 4
  local client;    client="$(pick_artifact client  "$version" "$base_url")" || exit 4

  # Downloads go to the cache dir (not TEMP_DIR) so curl -C - can resume
  # a previously interrupted download across runs.
  local dl_dir="${CACHE_DIR}/downloads"
  mkdir -p "$dl_dir"
  local installer_path="${dl_dir}/${installer}"
  local client_path="${dl_dir}/${client}"
  local extract_dir="${TEMP_DIR}/extract-${version}"
  local staged_dir="${TEMP_DIR}/staged-${version}"

  echo "➡️  Downloading ${version} (${OS_NAME}/${ARCH_NAME}) ..."

  download_with_progress "${base_url}/${installer}" "${installer_path}"
  download_with_progress "${base_url}/${client}" "${client_path}"

  verify_sha256 "$version" "${installer_path}" "$base_url"
  verify_sha256 "$version" "${client_path}"    "$base_url"

  echo "Extracting ..."
  extract_tar "${installer_path}" "${extract_dir}/installer"
  extract_tar "${client_path}"    "${extract_dir}/client"

  # Stage the final layout in the temp dir, validating contents, so a
  # failure here never leaves a half-populated version dir behind.
  mkdir -p "$staged_dir"
  [[ -f "${extract_dir}/installer/openshift-install" ]] \
    || { echo "Error: openshift-install not found in ${installer}" >&2; exit 4; }
  [[ -f "${extract_dir}/client/oc" ]] \
    || { echo "Error: oc not found in ${client}" >&2; exit 4; }
  mv -f "${extract_dir}/installer/openshift-install" "${staged_dir}/openshift-install"
  mv -f "${extract_dir}/client/oc"                   "${staged_dir}/oc"
  chmod +x "${staged_dir}/openshift-install" "${staged_dir}/oc"

  # Atomic-ish swap: only now touch the real version dir.
  mkdir -p "$(ocp_root)" "$(bin_root)"
  if [[ -d "$vd" ]]; then
    echo "Replacing existing installation (--force)..."
    rm -rf "$vd"
  fi
  mv "$staged_dir" "$vd"

  # Successful install: downloaded archives are no longer needed.
  rm -f "$installer_path" "$client_path"

  echo "Installed under ${vd}"
  link_version "$version"
}

# ---------- argument parsing ----------
declare -a args=()
for arg in "$@"; do
  case "$arg" in
    --dry-run)
      DRY_RUN=true
      ;;
    --force)
      FORCE=true
      ;;
    --ignore-sha)
      IGNORE_SHA=true
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

# Replace original argument list with the cleaned ones
if ((${#args[@]})); then
  set -- "${args[@]}"
else
  set --
fi

# Load configuration
load_config

# no args -> usage
if [[ $# -eq 0 ]]; then usage; exit 0; fi

# ---------- main ----------
case "$1" in
  list)
    case "${2:-}" in
      installed)
        list_installed_versions
        ;;
      latest)
        # ocv list latest [<series>] -> print latest patch of series, no install.
        # Single line on stdout (notes go to stderr) so it's script-friendly:
        #   ver="$(ocv list latest 4.18)"
        if [[ -n "${3:-}" ]]; then
          series="$3"
        elif [[ -n "$DEFAULT_SERIES" ]]; then
          series="$DEFAULT_SERIES"
          echo "Using remembered series: $series" >&2
        else
          echo "Usage: ocv list latest <series>   # e.g., ocv list latest 4.18" >&2
          exit 1
        fi
        resolve_latest_of_series "$series" || exit 1
        ;;
      remote|"")
        # default: GA versions with markers (* = active, + = installed)
        list_remote_versions | print_marked_versions
        ;;
      all)
        # GA plus every pre-release on the mirror
        list_all_versions | print_marked_versions
        ;;
      beta)
        # pre-releases whose GA hasn't shipped yet
        betas="$(list_beta_versions)" || exit 1
        if [[ -z "$betas" ]]; then
          echo "No pre-releases available right now (see 'ocv list all' for past ones)" >&2
          exit 0
        fi
        printf '%s\n' "$betas" | print_marked_versions
        ;;
      [0-9]*.[0-9]*)
        # ocv list 4.18 -> filter remote list by series (GA + unreleased betas)
        series="$2"
        [[ "$series" =~ ^[0-9]+\.[0-9]+$ ]] \
          || { echo "Invalid series: $series (use X.Y, e.g. 4.18)" >&2; exit 1; }
        { list_remote_versions && list_beta_versions; } \
          | grep -E "^${series//./\\.}\." \
          | version_sort \
          | grep . || {
          echo "No versions found for series $series" >&2
          exit 1
        }
        ;;
      *)
        echo "Unknown list target: '$2'" >&2
        echo "Expected: installed, latest [<series>], remote, beta, all, or a series like 4.18" >&2
        exit 1
        ;;
    esac
    ;;
  list-installed|list_installed)  # legacy aliases for 'list installed'
    list_installed_versions
    ;;
  use)
    [[ $# -ge 2 ]] || { usage; exit 0; }
    use_version "$2"
    ;;
  current)
    current_version
    ;;
  delete)
    [[ $# -ge 2 ]] || { usage; exit 0; }
    delete_version "$2"
    ;;
  check|check-update)
    check_for_updates
    ;;
  latest)
    remember=false
    if [[ $# -ge 2 ]]; then
      series="$2"
      remember=true
    elif [[ -n "$DEFAULT_SERIES" ]]; then
      series="$DEFAULT_SERIES"
      echo "Using remembered series: $series"
    else
      echo "No series specified and no default series configured"
      echo "Usage: ocv latest <series>  # e.g., ocv latest 4.18"
      exit 1
    fi

    ver="$(resolve_latest_of_series "$series")" || exit 1

    # Only remember the series once it is known to exist on the mirror, so a
    # typo can't overwrite a good remembered series.
    if $remember; then
      if $DRY_RUN; then
        echo "DRY-RUN: would remember series ${series} in ${CONFIG_FILE}"
      else
        DEFAULT_SERIES="$series"
        save_config
      fi
    fi

    echo "➡️  Series $series: latest patch = ${ver}"
    install_version "$ver"
    ;;
  -h|--help)
    usage
    ;;
  *)
    VERSION="$1"
    install_version "$VERSION"
    ;;
esac
